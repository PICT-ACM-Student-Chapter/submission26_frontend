# For local development with local backend server:
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# For production deployment with Next.js reverse proxy (Option B):
# Set this in Vercel/Hosting to eliminate Mixed Content errors when calling HTTP backend:
BACKEND_PROXY_URL=http://13.200.56.216

NEXT_PUBLIC_AWS_ACCESS_KEY=your_aws_access_key
NEXT_PUBLIC_AWS_SECRET_KEY=your_aws_secret_key
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_S3_BUCKET=pulzion-submissions-bucket
